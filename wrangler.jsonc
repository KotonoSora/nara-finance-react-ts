{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-worker",
  "compatibility_date": "2025-04-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "vars": {
    "VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare",
    "APP_NAME": "nara",
    "APP_DESCRIPTION": "tài chính cá nhân, quản lý dòng tiền, lập ngân sách, tiết kiệm, AI tài chính, quản lý chi tiêu",
    "APP_SLOGAN": "Kiểm soát tài chính, đơn giản hơn",
    "APP_DOMAIN": "nara.io",
    "APP_TITLE": "Quản lý tài chính cá nhân thông minh với AI",
    "APP_VERSION": "0.1.0",
    "APP_KEYWORDS": "tài chính cá nhân, quản lý dòng tiền, lập ngân sách, tiết kiệm, AI tài chính, quản lý chi tiêu",
    "APP_COPYRIGHT_TIME": "2025",
    "APP_COMPANY_NAME": "Công ty TNHH nara Việt Nam",
    "APP_COMPANY_ADDRESS": "123 YYY, Quận XX, TP. Hồ Chí Minh",
    "APP_COMPANY_PHONE": "+84 28 1234 5678",
    "APP_COMPANY_EMAIL": "contact@nara.io",
    "APP_COMPANY_TAX_ID": "0123456789",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "your-database-name",
      "database_id": "your-database-id",
      "migrations_dir": "drizzle",
    },
  ],
}
