{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-worker",
  "compatibility_date": "2025-04-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "vars": {
    "VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare",
    "BASIC_AUTH_USERNAME": "nara",
    "BASIC_AUTH_PASSWORD": "nara",
    "APP_NAME": "Nara Finance",
    "APP_DESCRIPTION": "Personal finance, cash flow management, budgeting, savings, AI-powered finance, expense tracking",
    "APP_SLOGAN": "Take control of your finances, made simple",
    "APP_DOMAIN": "nara.io",
    "APP_TITLE": "Smart personal finance management with AI",
    "APP_VERSION": "0.1.0",
    "APP_KEYWORDS": "personal finance, cash flow management, budgeting, savings, AI finance, expense tracking",
    "APP_COPYRIGHT_TIME": "2025",
    "APP_COMPANY_NAME": "Nara Finance Ltd.",
    "APP_COMPANY_ADDRESS": "123 YYY, District XX, Ho Chi Minh City",
    "APP_COMPANY_PHONE": "+84 28 1234 5678",
    "APP_COMPANY_EMAIL": "contact@nara.io",
    "APP_COMPANY_TAX_ID": "0123456789",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "your-database-name",
      "database_id": "your-database-id",
      "migrations_dir": "drizzle",
    },
  ],
}
